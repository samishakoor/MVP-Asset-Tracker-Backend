{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/api/users",
      "destination": "/api/users"
    },
    {
      "source": "/api/users/:path*",
      "destination": "/api/users/:path*"
    },
    {
      "source": "/api/assets",
      "destination": "/api/assets"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "/api/assets/:path*"
    },
    {
      "source": "/api/assignments",
      "destination": "/api/assignments"
    },
    {
      "source": "/api/assignments/:path*",
      "destination": "/api/assignments/:path*"
    },
    {
      "source": "/api/support-tickets",
      "destination": "/api/support-tickets"
    },
    {
      "source": "/api/support-tickets/:path*",
      "destination": "/api/support-tickets/:path*"
    },
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin/:path*"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/notifications"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "/api/notifications/:path*"
    },
    {
      "source": "/api/ping",
      "destination": "/api/ping"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
