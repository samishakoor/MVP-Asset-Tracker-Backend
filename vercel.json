{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/auth(.*)",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/users(.*)",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/assets(.*)",
      "dest": "/api/assets.js"
    },
    {
      "src": "/api/assignments(.*)",
      "dest": "/api/assignments.js"
    },
    {
      "src": "/api/support-tickets(.*)",
      "dest": "/api/support-tickets.js"
    },
    {
      "src": "/api/admin(.*)",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/notifications(.*)",
      "dest": "/api/notifications.js"
    },
    {
      "src": "/api/ping",
      "dest": "/api/ping.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
