# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_TIME=1d
JWT_EMAIL_VERIFICATION_TOKEN_EXPIRE_TIME=1h
JWT_PASSWORD_RESET_TOKEN_EXPIRE_TIME=1h

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name?schema=public

# Vercel build (runs once per deploy, not on every serverless request)
# Set SEED_ON_BUILD=false in Vercel to skip seeding on deploy
SEED_ON_BUILD=true

# Email Configuration (for nodemailer)
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
OAUTH_EMAIL=your_email@gmail.com
OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground

# Google OAuth (for login)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# For Vercel Production:
# - Set CLIENT_URL to your frontend URL (e.g., https://your-app.vercel.app)
# - Set GOOGLE_OAUTH_CALLBACK_URL to your backend URL (e.g., https://your-api.vercel.app/api/auth/google/callback)
# - Use a production-ready DATABASE_URL with connection pooling
